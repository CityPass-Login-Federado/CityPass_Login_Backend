# Service accounts. Deliberately OUTSIDE ou=People: the IdP's human search is
# based at ou=People, so nothing here can ever authenticate as a person.

# The IdP's search account. Password: readonly-secret
dn: cn=readonly,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: readonly
description: IdP search account. Read-only, used to resolve uid -> DN + memberOf.
userPassword: {SSHA}AfjJJ96UBAy7vi6BztKYLS0vBw5xy8OG

# Reserved for future write operations (password reset, provisioning).
# Unused in the PoC and deliberately has NO password set, so it cannot bind.
dn: cn=idp-admin,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
cn: idp-admin
description: Reserved for future admin operations. No password: cannot bind.

# groupOfNames requires at least one `member` -- an empty group is a schema
# violation. This entry exists solely to be that filler member. Do NOT delete
# it as "cleanup": app-movilidad-supervisor becomes invalid without it.
# It has no userPassword and no uid, so it cannot authenticate.
dn: cn=empty-group-placeholder,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
cn: empty-group-placeholder
description: Filler member for otherwise-empty groupOfNames entries. Not a real principal.
