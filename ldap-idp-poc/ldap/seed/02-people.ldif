# Humans. employeeNumber is the stable identifier and becomes the JWT `sub`.
# Values are HARDCODED, never generated, so that rebuilding the directory
# always yields the same subject for the same user.
# Password for all three: Password123!

# Roles in ONE module only (baseline case).
dn: uid=jperez,ou=People,dc=citypass,dc=local
objectClass: inetOrgPerson
uid: jperez
cn: Juan Perez
sn: Perez
givenName: Juan
mail: jperez@citypass.local
employeeNumber: CP-8f7d2c10
userPassword: {SSHA}rfYdye/pu9bdC0aGTVR6GJZ+/RNm2EQR

