# Copiar como .env y completar. Docker Compose lo lee automáticamente.
# Todas tienen default en application.yml: este archivo solo pisa lo que cambia.

# --- SMTP (envío real del enlace de recupero) ---
# Sin SPRING_MAIL_HOST la app usa modo dev: imprime el enlace en consola.
# Gmail: activar "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-cuenta@gmail.com
SPRING_MAIL_PASSWORD=XXXX XXXX XXXX XXXX

# --- Self-service de contraseñas ---
# En producción SIEMPRE PASSWORD_RESET_DEBUG_LOG=false: el token va por mail, jamás a consola.
PASSWORD_RESET_DEBUG_LOG=false
PASSWORD_RESET_FROM=no-reply@citypass.local
PASSWORD_RESET_LINK_BASE=https://api.citypass-login.pp.ua/reset-password

# --- CORS del frontend (lista separada por comas; el default dev ya cubre localhost:3000) ---
CORS_ALLOWED_ORIGINS=https://citypass-login.pp.ua

# --- Secrets de producción (los defaults son solo para dev) ---
#LDAP_READONLY_PASSWORD=
#PANEL_LDAP_PASSWORD=
#DB_USERNAME=citypass
#DB_PASSWORD=
#SVC_GROUP1_SECRET=
#SVC_GROUP5_SECRET=
#SVC_GRUPO2_SECRET=