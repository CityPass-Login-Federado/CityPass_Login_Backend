{
  "openapi": "3.0.3",
  "info": {
    "title": "CityPass+ Login Federado — API",
    "description": "Proveedor de identidad (IdP) de CityPass+.\n\n**Autenticación** (`/auth`): login, refresh y logout con LDAP + JWT (RS256).\n**Perfil** (`/me`): acciones autenticadas del usuario sobre su propia cuenta (requiere access token humano).\n**Panel de administración** (`/panel`): ABM de personas y grupos, exclusivo para delegados de módulo (o admin-global con `?module=`).\n**OAuth** (`/oauth/token`): tokens de servicio backend-a-backend (client_credentials).\n**JWKS** (`/.well-known/jwks.json`): clave pública para que otros módulos validen tokens sin llamarnos.\n**Salud** (`/actuator/health`): estado del servicio.\n\nSwagger UI disponible en `/docs`. OpenAPI JSON en `/v3/api-docs`. Puertos: API `8081`, anomaly-detection `8000`, LDAP `389`, Postgres `5432`.",
    "version": "0.1.0-SNAPSHOT",
    "contact": {
      "name": "Grupo 2",
      "email": "grupo2@citypass.local"
    },
    "license": {
      "name": "UADE"
    }
  },
  "servers": [
    { "url": "http://localhost:8081", "description": "Desarrollo (API Java)" },
    { "url": "http://localhost:8000", "description": "Anomaly-detection (FastAPI: GET /health, POST /score)" }
  ],
  "security": [
    { "bearer-jwt": [] }
  ],
  "tags": [
    { "name": "Autenticación", "description": "Login, refresh, logout y recupero públicos (contrato §2). Todo fallo de login devuelve el mismo 401 genérico (anti-enumeración); el recupero siempre 204." },
    { "name": "Perfil", "description": "Acciones autenticadas del usuario sobre su propia cuenta. Requiere access token humano (token_use=human); el servicio rechaza con 403." },
    { "name": "Panel — Personas", "description": "ABM de personas, exclusivo para delegados de módulo o admin-global (con ?module=)." },
    { "name": "Panel — Grupos", "description": "ABM de grupos y membresías, exclusivo para delegados de módulo o admin-global (con ?module=). Incluye GET /panel/modules." },
    { "name": "OAuth", "description": "Token de servicio backend-a-backend (client_credentials, contrato §7)." },
    { "name": "Infraestructura", "description": "Descubrimiento de claves públicas (JWKS) y estado del servicio (actuator/health)." }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Login de usuario",
        "description": "Autentica contra LDAP y emite access + refresh token. Los errores de credencial, usuario inexistente, cliente desconocido, módulo cruzado, cuenta deshabilitada, lockout (5 fallos/15 min), bloqueo por anomalías (IA) y anomaly-service caído (fail-closed) devuelven exactamente la misma respuesta 401 (anti-enumeración). El clientId debe corresponder al módulo LDAP del usuario, salvo citypass-admin-web (transversal, emite aud citypass-admin-api).",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access + refresh token emitidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "Validación de campos fallida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas (genérico)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Refresh token",
        "description": "Canjea un refresh token opaco por un par nuevo (rotación RFC 9700). Revalida contra LDAP en cada canje. El reuso de un token ya canjeado revoca toda la cadena.",
        "operationId": "refresh",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Par de tokens rotados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "Validación de campos fallida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Refresh token inválido, revocado o cadena muerta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Logout",
        "description": "Invalida la sesión (revoca el refresh canjeable). Persiste. El access token vigente sigue vivo hasta 15 minutos: aceptado y esperado. Token desconocido → 204 igual: no se revela si alguna vez existió.",
        "operationId": "logout",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Sesión invalidada (token inexistente devuelve lo mismo)" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Solicitar recupero de contraseña",
        "description": "Emite un token de un solo uso y lo manda por mail como enlace. NO escribe en LDAP al pedir: la contraseña cambia recién al canjear el token en /auth/reset-password. Responde SIEMPRE 204 (usuario existente o no, limitado o no): no se puede enumerar el directorio ni detectar el freno anti-abuso. Cooldown por cuenta + topes por cuenta e IP.",
        "operationId": "forgotPassword",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Procesado (el mail llega solo si el usuario existe y tiene email)" },
          "400": {
            "description": "Validación de campos fallida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Canjear token de recupero",
        "description": "Define la nueva contraseña con el token del enlace del mail (un solo uso, con vencimiento). Al canjear se revocan TODAS las sesiones vigentes de la cuenta, igual que en /me/change-password.",
        "operationId": "resetPassword",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Contraseña restablecida y sesiones revocadas" },
          "400": {
            "description": "Validación de campos fallida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "422": {
            "description": "Enlace inválido o expiró",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/me/change-password": {
      "post": {
        "tags": ["Perfil"],
        "summary": "Cambiar mi contraseña",
        "description": "Cambia la contraseña de la persona autenticada. Valida la contraseña actual contra LDAP (segundo factor: un JWT robado sin la clave vigente no alcanza) y revoca todas sus sesiones (refresh tokens). Requiere token_use=human (un token de servicio devuelve 403). Errores de negocio (clave actual mala, nueva < 8 chars, cuenta inexistente) devuelven 422.",
        "operationId": "changePassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Contraseña cambiada y sesiones revocadas" },
          "400": {
            "description": "Validación de campos fallida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "422": {
            "description": "Contraseña actual incorrecta o nueva muy corta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": ["OAuth"],
        "summary": "Token de servicio (client_credentials)",
        "description": "Emite un JWT de servicio backend-a-backend. Autenticación por Basic Auth (client_id:client_secret). Solo se admite grant_type=client_credentials. El token NO trae groups ni module: su identidad es el namespace.",
        "operationId": "serviceToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "description": "Grant type; solo se admite client_credentials",
                    "enum": ["client_credentials"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT de servicio emitido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceTokenResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciales de servicio inválidas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": ["Infraestructura"],
        "summary": "Clave pública JWKS",
        "description": "Expone la clave pública RS256 del IdP en formato JWKS (RFC 7517) para que otros módulos validen tokens sin llamarnos.",
        "operationId": "jwks",
        "security": [],
        "responses": {
          "200": {
            "description": "JWKSet con la clave pública de firma (nunca la privada)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Objeto JWKSet estándar (keys[], keys[].kid, keys[].kty, etc.)"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "tags": ["Infraestructura"],
        "summary": "Estado del servicio",
        "description": "Health check de Spring Actuator. Debe responder {\"status\":\"UP\"} antes de correr cualquier prueba.",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio arriba",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "UP" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/panel/people": {
      "get": {
        "tags": ["Panel — Personas"],
        "summary": "Listar personas del módulo",
        "description": "Lista paginada de personas del módulo del delegado. Solo ve el módulo de su token: nunca personas de otros módulos. Filtros opcionales: search, group y disabled.",
        "operationId": "listPeople",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 }, "description": "Número de página (base 0)" },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "Tamaño de página" },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Texto libre en nombre, apellido, uid o mail" },
          { "name": "group", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Nombre de grupo para filtrar por membresía" },
          { "name": "disabled", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "true: solo deshabilitadas; false: solo habilitadas" }
        ],
        "responses": {
          "200": {
            "description": "Página de personas del módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedPersonResponse" }
              }
            }
          },
          "400": {
            "description": "Admin global sin ?module= o módulo inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" }
        }
      },
      "post": {
        "tags": ["Panel — Personas"],
        "summary": "Crear persona",
        "description": "Alta con ID automático secuencial (D3): el employeeNumber lo asigna el sistema, nadie lo elige. Unicidad global de username y email pre-chequeada.",
        "operationId": "createPerson",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPersonRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persona creada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PersonView" }
              }
            }
          },
          "400": {
            "description": "Validación de campos fallida (@NotBlank en givenName/sn/username/email/temporaryPassword)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "422": {
            "description": "Regla de negocio incumplida (ej: username duplicado)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/people/{uid}": {
      "get": {
        "tags": ["Panel — Personas"],
        "summary": "Obtener persona por UID",
        "description": "Ficha completa de una persona del propio módulo.",
        "operationId": "getPerson",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "responses": {
          "200": {
            "description": "Ficha de la persona",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PersonView" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "404": {
            "description": "Persona inexistente en el módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Panel — Personas"],
        "summary": "Actualizar persona",
        "description": "Corrección de datos y/o renombre con reparación de membresías. El employeeNumber es inmutable (D3): no existe campo para cambiarlo.",
        "operationId": "updatePerson",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdatePersonRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persona actualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PersonView" }
              }
            }
          },
          "400": {
            "description": "Admin global sin ?module= o módulo inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "404": {
            "description": "Persona inexistente en el módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          },
          "422": {
            "description": "Regla de negocio incumplida",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/people/{uid}/disable": {
      "post": {
        "tags": ["Panel — Personas"],
        "summary": "Deshabilitar persona (baja D7)",
        "description": "Nunca borra la ficha: bloquea vía ppolicy Y mata todas las sesiones vivas (refresh tokens) al instante.",
        "operationId": "disablePerson",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "responses": {
          "204": { "description": "Persona deshabilitada y sesiones revocadas" },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "404": {
            "description": "Persona inexistente en el módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/people/{uid}/enable": {
      "post": {
        "tags": ["Panel — Personas"],
        "summary": "Rehabilitar persona",
        "description": "Recupera identidad, historial y grupos intactos.",
        "operationId": "enablePerson",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "responses": {
          "204": { "description": "Persona rehabilitada" },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "404": {
            "description": "Persona inexistente en el módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/people/{uid}/reset-password": {
      "post": {
        "tags": ["Panel — Personas"],
        "summary": "Resetear contraseña",
        "description": "Asigna una contraseña temporal. La persona debe cambiarla al entrar.",
        "operationId": "resetPassword",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Contraseña reiniciada" },
          "400": {
            "description": "temporaryPassword ausente (validación @NotBlank)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "404": {
            "description": "Persona inexistente en el módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/groups": {
      "get": {
        "tags": ["Panel — Grupos"],
        "summary": "Listar grupos del módulo",
        "description": "Lista paginada de grupos del módulo del delegado. El grupo reservado 'delegados' aparece marcado con reserved=true.",
        "operationId": "listGroups",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 0 }, "description": "Número de página (base 0)" },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "Tamaño de página" },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Texto libre en el nombre del grupo" },
          { "name": "reserved", "in": "query", "required": false, "schema": { "type": "boolean" }, "description": "true: solo grupos reservados; false: solo no reservados" }
        ],
        "responses": {
          "200": {
            "description": "Página de grupos del módulo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedGroupResponse" }
              }
            }
          },
          "400": {
            "description": "Admin global sin ?module= o módulo inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" }
        }
      },
      "post": {
        "tags": ["Panel — Grupos"],
        "summary": "Crear grupo",
        "description": "D6: solo minúsculas, números y guiones. 'delegados' es reservado y se niega dentro del servicio.",
        "operationId": "createGroup",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GroupCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Grupo creado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GroupView" }
              }
            }
          },
          "400": {
            "description": "Nombre ausente (validación @NotBlank)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "409": {
            "description": "Conflicto: el grupo ya existe o es 'delegados'",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          },
          "422": {
            "description": "Regla de negocio incumplida (nombre inválido D6)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/groups/{name}": {
      "delete": {
        "tags": ["Panel — Grupos"],
        "summary": "Eliminar grupo",
        "description": "El grupo reservado 'delegados' no se puede borrar.",
        "operationId": "deleteGroup",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/groupName" }
        ],
        "responses": {
          "204": { "description": "Grupo eliminado" },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "409": {
            "description": "Conflicto: es el grupo reservado 'delegados'",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/groups/{name}/members": {
      "post": {
        "tags": ["Panel — Grupos"],
        "summary": "Agregar miembro a grupo",
        "description": "Solo se agregan personas (no grupos). D5: máximo 50 grupos por persona.",
        "operationId": "addMember",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/groupName" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MemberRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grupo resultante con el miembro agregado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MembershipChangeResponse" }
              }
            }
          },
          "400": {
            "description": "memberUid ausente (validación)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "422": {
            "description": "Regla de negocio incumplida (ej: tope D5)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/groups/{name}/members/{uid}": {
      "delete": {
        "tags": ["Panel — Grupos"],
        "summary": "Quitar miembro de grupo",
        "description": "Si el grupo es 'delegados', no puede quedar vacío.",
        "operationId": "removeMember",
        "parameters": [
          { "name": "module", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Módulo a operar (solo admin global)" },
          { "$ref": "#/components/parameters/groupName" },
          { "$ref": "#/components/parameters/uid" }
        ],
        "responses": {
          "200": {
            "description": "Grupo resultante sin el miembro",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MembershipChangeResponse" }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" },
          "422": {
            "description": "Regla de negocio incumplida (ej: 'delegados' no puede quedar vacío)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BusinessError" }
              }
            }
          }
        }
      }
    },
    "/panel/modules": {
      "get": {
        "tags": ["Panel — Grupos"],
        "summary": "Listar módulos existentes",
        "description": "Los 6 módulos del directorio. Pensado para que el admin global sepa qué valores acepta ?module=?; un delegado normal solo recuerda que su módulo viene de su token.",
        "operationId": "listModules",
        "responses": {
          "200": {
            "description": "Lista de módulos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string", "example": "movilidad" }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente o inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthErrorResponse" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/AccessDenied" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer-jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT emitido por el IdP. Panel requiere: aud=citypass-admin-api, token_use=human, ver=1, claim module y grupo delegados (claim module) O grupo admin-global (módulo vía ?module= en cada request, obligatorio). Sin token → 401; sin claims → 403."
      }
    },
    "parameters": {
      "uid": {
        "name": "uid",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "UID (preferred_username) de la persona"
      },
      "groupName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "description": "Nombre del grupo (solo minúsculas, números, guiones)"
      }
    },
    "responses": {
      "AccessDenied": {
        "description": "Token sin claims requeridos (audience, grupo delegados o admin-global, claim module)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AccessDeniedError" }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password", "clientId"],
        "properties": {
          "username": { "type": "string", "description": "Nombre de usuario (uid en LDAP)", "example": "jperez" },
          "password": { "type": "string", "description": "Contraseña en texto plano", "example": "changeit123" },
          "clientId": { "type": "string", "description": "client_id de la aplicación (ej: citypass-admin-web, citypass-reclamos-web)", "example": "citypass-admin-web" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "description": "JWT RS256, vida 15 min" },
          "refresh_token": { "type": "string", "description": "Token opaco rotativo, vida 8 h" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "format": "int64", "description": "Segundos hasta expiración del access token", "example": 900 }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "description": "Refresh token vigente", "example": "rt_xxxx" }
        }
      },
      "ServiceTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "description": "JWT RS256 de servicio (sin groups ni module)" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "format": "int64", "description": "Segundos hasta expiración", "example": 3600 }
        }
      },
      "AuthErrorResponse": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "integer", "example": 401 },
          "error": { "type": "string", "example": "Credenciales inválidas" },
          "message": { "type": "string", "example": "Usuario o contraseña inválidos" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["uid"],
        "properties": {
          "uid": { "type": "string", "description": "UID del usuario (uid en LDAP). Se acepta 'username' como alias legacy.", "example": "jperez" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string", "description": "Contraseña vigente (se valida contra LDAP)", "example": "changeit123" },
          "newPassword": { "type": "string", "minLength": 8, "description": "Nueva contraseña (mín 8 chars)", "example": "nuevaClaveFu553" }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string", "description": "Token crudo del enlace de recupero", "example": "dGhpcyBpcyBhIHRlc3QgdG9rZW4" },
          "newPassword": { "type": "string", "minLength": 8, "description": "Nueva contraseña (mín 8 chars)", "example": "nuevaClaveFu553" }
        }
      },
      "AccessDeniedError": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "integer", "example": 403 },
          "error": { "type": "string", "example": "Acceso denegado" },
          "message": { "type": "string", "example": "No tiene permisos para acceder a este recurso" }
        }
      },
      "BusinessError": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "integer", "description": "422 (regla de negocio) o 409 (conflicto)" },
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "NewPersonRequest": {
        "type": "object",
        "required": ["givenName", "sn", "username", "email", "temporaryPassword"],
        "properties": {
          "givenName": { "type": "string", "description": "Nombre", "example": "Test" },
          "sn": { "type": "string", "description": "Apellido", "example": "Usuario" },
          "username": { "type": "string", "description": "Nombre de usuario (3-32 chars, a-z 0-9 . _ -), único global", "example": "test.user" },
          "email": { "type": "string", "format": "email", "description": "Mail, único global", "example": "test.user@citypass.local" },
          "temporaryPassword": { "type": "string", "description": "Contraseña inicial (mín 8 chars); el usuario debe cambiarla al entrar", "example": "temporal123" }
        }
      },
      "UpdatePersonRequest": {
        "type": "object",
        "properties": {
          "givenName": { "type": "string", "description": "Nombre (opcional, null = sin cambio)", "example": "Juan" },
          "sn": { "type": "string", "description": "Apellido (opcional, null = sin cambio)", "example": "Perez" },
          "email": { "type": "string", "format": "email", "description": "Mail (opcional, null = sin cambio)", "example": "jperez@citypass.local" },
          "newUsername": { "type": "string", "description": "Nuevo username: dispara renombre con reparación de membresías", "example": "juan.perez" }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": ["temporaryPassword"],
        "properties": {
          "temporaryPassword": { "type": "string", "description": "Nueva contraseña temporal (mín 8 chars)", "example": "nueva-temp-456" }
        }
      },
      "PersonView": {
        "type": "object",
        "properties": {
          "employeeNumber": { "type": "string", "description": "ID estable, formato U000000 (inmutable, D3)", "example": "U000042" },
          "uid": { "type": "string", "description": "Nombre de usuario (uid)", "example": "jperez" },
          "givenName": { "type": "string", "description": "Nombre", "example": "Juan" },
          "sn": { "type": "string", "description": "Apellido", "example": "Perez" },
          "email": { "type": "string", "description": "Mail", "example": "jperez@citypass.local" },
          "disabled": { "type": "boolean", "description": "true si la cuenta está bloqueada vía ppolicy (D7)" }
        }
      },
      "PaginatedPersonResponse": {
        "type": "object",
        "properties": {
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/PersonView" }, "description": "Elementos de la página actual" },
          "totalElements": { "type": "integer", "format": "int64", "description": "Total de elementos en el módulo" },
          "totalPages": { "type": "integer", "description": "Total de páginas" },
          "currentPage": { "type": "integer", "description": "Página actual (base 0)" },
          "size": { "type": "integer", "description": "Tamaño de página" }
        }
      },
      "GroupCreateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Nombre del grupo (a-z, 0-9, guiones; máx 64)", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "example": "soporte-n2" }
        }
      },
      "GroupView": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Nombre del grupo", "example": "soporte-n2" },
          "members": { "type": "array", "items": { "type": "string" }, "description": "UIDs de las personas miembros (el placeholder técnico nunca aparece)" },
          "reserved": { "type": "boolean", "description": "true si es el grupo reservado 'delegados'" }
        }
      },
      "PaginatedGroupResponse": {
        "type": "object",
        "properties": {
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/GroupView" }, "description": "Elementos de la página actual" },
          "totalElements": { "type": "integer", "format": "int64", "description": "Total de elementos en el módulo" },
          "totalPages": { "type": "integer", "description": "Total de páginas" },
          "currentPage": { "type": "integer", "description": "Página actual (base 0)" },
          "size": { "type": "integer", "description": "Tamaño de página" }
        }
      },
      "MemberRequest": {
        "type": "object",
        "required": ["memberUid"],
        "properties": {
          "memberUid": { "type": "string", "description": "UID de la persona a agregar", "example": "test-user" }
        }
      },
      "MembershipChangeResponse": {
        "type": "object",
        "properties": {
          "group": { "$ref": "#/components/schemas/GroupView" },
          "warnings": { "type": "array", "items": { "type": "string" }, "description": "Avisos preventivos (ej: acumula 30+ grupos, D5)" }
        }
      }
    }
  }
}