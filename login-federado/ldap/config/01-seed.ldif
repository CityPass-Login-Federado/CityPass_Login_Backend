# =============================================================================
# CityPass+ — Árbol de identidades (spec 01-DISENO-IDENTIDAD.md §2.2)
#
# ESTE ARCHIVO NO LO CARGA EL BOOTSTRAP DE LA IMAGEN: lo aplica
# apply-config.sh DESPUÉS de activar los overlays (memberof/refint/unique/
# ppolicy/constraint). Ese orden es obligatorio: si los grupos se cargan
# antes del overlay memberof, las referencias inversas nunca se calculan
# para las entradas existentes y todos los tokens saldrían sin grupos,
# sin ningún error en ningún lado.
#
# Contraseñas de prueba: changeit123 (hashes SSHA pre-generados).
# =============================================================================

version: 1

# -----------------------------------------------------------------------------
# OUs de módulos (fijas, creadas por Grupo 2). Cada módulo tiene People/Groups.
# -----------------------------------------------------------------------------

dn: ou=Movilidad,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Movilidad

dn: ou=People,ou=Movilidad,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Movilidad,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Residuos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Residuos

dn: ou=People,ou=Residuos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Residuos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Reclamos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Reclamos

dn: ou=People,ou=Reclamos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Reclamos,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Emergencias,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Emergencias

dn: ou=People,ou=Emergencias,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Emergencias,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Espacios,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Espacios

dn: ou=People,ou=Espacios,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Espacios,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

dn: ou=Analitica,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Analitica

dn: ou=People,ou=Analitica,dc=citypass,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Analitica,dc=citypass,dc=local
objectClass: organizationalUnit
ou: Groups

# -----------------------------------------------------------------------------
# ou=ServiceAccounts — fuera del alcance de búsqueda de personas y fuera de
# lo que el panel administra (spec §2.8: una cuenta administrativa no puede
# vivir dentro del alcance que administra).
# -----------------------------------------------------------------------------

dn: ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalUnit
ou: ServiceAccounts

# Cuenta con la que el IdP BUSCA. Solo lectura (lo fuerza la ACL).
dn: cn=readonly,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: readonly
description: Cuenta de busqueda del IdP - solo lectura
userPassword: {SSHA}jg5pmnIvvyYBAwthE8wGH/8xmNfY5JkxgzQhkA==

# Credencial interna con la que el BACKEND DEL PANEL escribe. Los delegados
# no la conocen ni la necesitan (spec §2.8).
dn: cn=panel-writer,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: panel-writer
description: Cuenta de escritura del backend del panel
userPassword: {SSHA}xbwXmMs8GJjz8yN2BzdZL6sO/g9cPdrljExTuw==

# Relleno técnico: el estándar no permite grupos vacíos. Se anota como miembro
# inicial de cada grupo; el IdP la ignora al armar tokens y el panel nunca la
# muestra (spec §2.6).
dn: cn=empty-group-placeholder,ou=ServiceAccounts,dc=citypass,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: empty-group-placeholder
description: Miembro tecnico para que ningun grupo quede vacio - ignorar
userPassword: {SSHA}mfAwIET/pDulJ/sD/5aDquTVP4stOEKk8HxlAw==

# -----------------------------------------------------------------------------
# Política de contraseñas por defecto (overlay ppolicy).
# Nota: Esta definición es para cn=config; en el DIT se gestiona diferente.
# Por ahora se omite del seed.

# dn: ou=Policies,dc=citypass,dc=local
# objectClass: organizationalUnit
# ou: Policies

# dn: cn=default,ou=Policies,dc=citypass,dc=local
# objectClass: organizationalRole
# objectClass: pwdPolicy
# cn: default
# pwdAttribute: userPassword
# pwdLockout: FALSE
# pwdMinLength: 8

